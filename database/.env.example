# IoT Saathi Database Service Environment Configuration
PORT=8001

# Database Connection URL:
# For local development (zero configuration SQLite):
# Leave blank or set to: sqlite:///./iot_saathi_store.db
# For Render PostgreSQL (Render provides this automatically as an environment variable):
# DATABASE_URL=postgresql://username:password@dpg-xxx-a.oregon-postgres.render.com/iot_saathi_db
DATABASE_URL=sqlite:///./iot_saathi_store.db

# Admin Secret Authentication Password (must match admin panel login)
ADMIN_PASSWORD=iotsaathi_admin_2026

# WhatsApp contact number for store orders
WHATSAPP_NUMBER=919389860087

# Allowed CORS Origins (comma separated or * for open access)
CORS_ORIGINS=*
