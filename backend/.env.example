# Gemini API Key (Get from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000

# Admin Panel Password - CHANGE THIS BEFORE DEPLOYING!
ADMIN_PASSWORD=your_secure_admin_password_here

# WhatsApp Business Number for customer orders (with country code, no + or spaces)
# This is the number customers will message when placing orders via the E-Tron Store.
# Format: country_code + number  e.g. 919389860087 for +91 93898 60087
mobileNumber=your_whatsapp_number_here
MOBILE_NUMBER=your_whatsapp_number_here
